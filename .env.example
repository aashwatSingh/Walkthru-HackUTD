# Copy to .env.local (never commit .env.local). Also add these in Vercel → Project → Settings → Environment Variables.
# Leave VITE_SUPABASE_URL empty to run in MOCK mode (everything works offline from seeded sample data).
# A DEPLOYED site with it empty refuses to start (so nobody does an inspection that is saved nowhere),
# unless you also set VITE_DEMO_MODE=true to say the deployment is a sample-data demo on purpose.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=          # the public "anon" / "publishable" key. NEVER the service role key
# Where QR codes send phones. Leave EMPTY on Vercel: codes then use the address the site is on.
# Set it only when printing codes from your laptop, to YOUR deployed link (e.g. https://YOUR-PROJECT.vercel.app).
# Never localhost: a phone can't open your laptop's localhost.
VITE_PUBLIC_SITE_URL=
# VITE_DEMO_MODE=true            # only for a deployed demo with NO database
VITE_DEMO_PASSWORD=              # password you gave the demo STUDENTS; enables the Demo switcher + quick-login buttons.
                                 # Anyone can read it in the site's code: leave it empty outside a public demo.
# VITE_REQUIRE_ADMIN_MFA=false   # emergency only: stop asking the housing admin for an authenticator code
